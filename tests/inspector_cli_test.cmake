function(check expected_exit expected_text)
  execute_process(COMMAND "${INSPECTOR}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "${ARGN}: expected exit ${expected_exit}, got ${result}\n${output}${error}")
  endif()
  string(FIND "${output}${error}" "${expected_text}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "${ARGN}: missing '${expected_text}'\n${output}${error}")
  endif()
endfunction()

